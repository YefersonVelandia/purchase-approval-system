# Región AWS donde se despliegan los recursos
AWS_REGION=us-east-1

# Nombre de la tabla DynamoDB para solicitudes de compra
PURCHASE_REQUESTS_TABLE=PurchaseRequests-dev

# Nombre de la tabla DynamoDB para aprobaciones
APPROVALS_TABLE=Approvals-dev

# Nombre del bucket S3 para almacenar PDFs de evidencia
# En AWS se usa !Ref EvidenceBucket; en local se usa este valor
S3_BUCKET_NAME=purchase-approval-evidence-dev

# Ambiente: dev (mock storage) | prod (S3 real)
NODE_ENV=dev

# URL base para enlaces de aprobación en correos
# En dev: http://localhost:3001/approvals
# En prod: http://<bucket>.s3-website-<region>.amazonaws.com/#/approvals
APPROVAL_BASE_URL=http://localhost:3001/approvals
